<?php

declare(strict_types=1);

$event = $event ?? [];
$currentWeek = (int) ($currentWeek ?? 0);
$detailed = (bool) ($detailed ?? false);
$today = app_today_date();
$isToday = ($event['event_date'] ?? '') === $today;
?>

<article class="timeline-event intern-calendar-row <?= $currentWeek > 0 && (int) ($event['week'] ?? 0) === $currentWeek ? 'current-week-card' : '' ?> <?= $isToday ? 'today-highlight' : '' ?>" data-event-date="<?= Wo_Secure((string) ($event['event_date'] ?? '')) ?>">
    <span class="pill success">Week <?= (int) ($event['week'] ?? 0) ?></span>
    <h3 class="timeline-title"><?= Wo_Secure((string) ($event['title'] ?? '')) ?></h3>
    <p class="timeline-desc"><?= $detailed ? Wo_Secure((string) ($event['description'] ?? '')) : Wo_Secure(app_text_preview((string) ($event['description'] ?? ''), 120)) ?></p>
    <div class="timeline-meta">
        <span class="pill"><?= Wo_Secure(app_format_date((string) ($event['event_date'] ?? ''))) ?></span>
        <?php if ($isToday): ?>
            <span class="pill success">Today</span>
        <?php endif; ?>
        <a class="ghost-btn" href="index.php?link1=internship-calendar-event&eid=<?= (int) ($event['id'] ?? 0) ?>">Details</a>
    </div>
</article>
